{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"declaration": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"],
	// Bun-Tests (*.test.ts, `bun:test`) laufen über `bun test`, nicht über
	// svelte-check — sie ziehen sonst fremde Service-Quellen + bun:test-Typen
	// in den UI-Check. avatar.test.ts importiert z.B. mana-analytics/src.
	"exclude": ["src/**/*.test.ts"]
}
